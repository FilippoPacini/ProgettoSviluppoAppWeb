rules_version = '2';

// Ogni utente vede e scrive solo il proprio sotto-albero users/{uid}/...
// Le regole si combinano in OR: una wildcard permissiva accanto a una regola severa
// renderebbe la seconda inutile, perche' basta che UNA regola conceda l'accesso.
// Per questo qui non c'e' nessun match /{document=**}: ogni collezione e' dichiarata.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Validazione di contenuto sulle sole due collezioni la cui corruzione romperebbe
    // tutti i conteggi. Si controllano i campi obbligatori con hasAll(), non hasOnly():
    // elencare i campi ammessi bloccherebbe l'app al primo campo nuovo (measure,
    // pauses, active sono stati aggiunti dopo la prima stesura di queste regole).
    function validHabit() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'frequency'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.frequency in ['daily', 'custom'];
    }

    function validCompletion() {
      return request.resource.data.habits is list;
    }

    match /users/{userId} {
      // Documento utente: profilo, report e citazione del giorno.
      allow read, write: if isOwner(userId);

      match /habits/{habitId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHabit();
      }

      match /completions/{dateId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCompletion();
      }

      // Obiettivi e diario: solo controllo di proprieta'. La loro forma e' piu'
      // variabile e una validazione stretta rischierebbe di bloccare l'utente
      // senza proteggere niente di importante.
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /diary/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
